# ------------------------------------------------------------------------------ #
# Java defaults (https://github.com/github/gitignore/blob/master/Java.gitignore) #
# ------------------------------------------------------------------------------ #
*.class

# Package Files #
*.jar
*.war
*.ear

# ------------------------------------------------------------------------------------------- #
# Eclipse-specific (https://github.com/github/gitignore/blob/master/Global/Eclipse.gitignore) #
# ------------------------------------------------------------------------------------------- #
*.pydevproject
.metadata
bin/**
tmp/**
tmp/**/*
*.tmp
*.bak
*.swp
*~.nib
local.properties
.settings/
.loadpath
.project
.classpath

# External tool builders
.externalToolBuilders/

# Locally stored "Eclipse launch configurations"
*.launch

# CDT-specific
.cproject

# PDT-specific
.buildpath

# --------------- #
# Studio-specific #
# --------------- #
target/
.mule/
.DS_Store
velocity.log

# ------------------------------------------------ #
# Secrets (Salesforce JWT setup), never commit     #
# ------------------------------------------------ #
*.jks
*.p12
*.pfx
*.key
*.pem
sf-jwt.crt

# Property files holding real credentials
# (commit a template such as config.example.yaml with dummy values instead)
src/main/resources/secrets*.yaml
src/main/resources/secrets*.properties
src/main/resources/*-local.yaml
src/main/resources/*-local.properties

# ----------------- #
# Other IDEs / logs #
# ----------------- #
*.log
*.iml
.idea/
.vscode/